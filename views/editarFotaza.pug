h1 Editar Fotaza
form(action=`/fotazas/edit/${foto.id}` method="POST")
  div
    label Título:
    br
    input(type="text" name="titulo" value=foto.titulo required=true)
  br
  div
    label Descripción:
    br
    textarea(name="descripcion" required=true)= foto.descripcion
  br
  div
    label URL de la Imagen:
    br
    input(type="text" name="url_imagen" value=foto.url_imagen required=true)
  br
  div
    label Etiquetas (separadas por comas):
    br
    input(type="text" name="etiquetas" value=foto.etiquetas required=true)
  br
  button(type="submit") Actualizar Cambios
br
a(href="/fotazas") Cancelar y volver